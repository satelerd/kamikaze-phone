# ElevenLabs API key: needed only to sync the agent (elevenlabs auth login).
# The web app itself never sees this key; it only needs the public agent id.
ELEVENLABS_API_KEY=your_api_key_here

# Public agent id consumed by the Next.js app (put it in the repo root .env.local):
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_...
