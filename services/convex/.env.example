# Copy values to the Convex dev deployment environment (never commit secrets).
# The issuer must match the `iss` claim in the OIDC ID token exactly, and the
# application ID must match its `aud` claim exactly.
KAMIKAZE_OIDC_ISSUER=https://replace-with-your-oidc-issuer.example
KAMIKAZE_OIDC_APPLICATION_ID=replace-with-your-oidc-client-or-service-id
